{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test",
    "preflight": "node --env-file-if-exists=.env scripts/workpilot-preflight.mjs",
    "dev:rehearsal": "node scripts/workpilot-rehearsal.mjs",
    "test:e2e": "node scripts/workpilot-e2e.mjs",
    "verify:release": "npm run verify && npm run build --workspace web && npm run test:e2e"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
