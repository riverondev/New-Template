# ─────────────────────────────────────────────────────────────────────────────
# WorkPilot — environment template
#
#   cp .env.example .env      then fill in your credentials.
#
# ─────────────────────────────────────────────────────────────────────────────


# ── MODEL PROVIDER · choose one ──────────────────────
# openai | openrouter | ollama
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-proj-replace-me
MODEL=gpt-4o

# OpenRouter alternative:
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-me
# MODEL=openai/gpt-4o

# Ollama (local):
# MODEL_PROVIDER=ollama
# MODEL=workpilot-qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1


# ── WORKPILOT · Jira Cloud ────────────────────────────
# Set WORKPILOT_DEMO=true to use isolated simulated providers (no credentials needed).
# Set WORKPILOT_DEMO=false and fill the fields below for real Jira/Slack.
WORKPILOT_DEMO=true

JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_KEY=WP

# Real Jira issue type ID with subtask=true, from your project's metadata.
JIRA_SUBTASK_ISSUE_TYPE_ID=10006

# Explicit opt-in. Without it real approval returns WRITES_DISABLED.
JIRA_WRITES_ENABLED=false

PLAN_TTL_MINUTES=30

# Absolute persistent directory recommended. Defaults to apps/web/.data/workpilot.
# WORKPILOT_DATA_DIR=/absolute/path/to/workpilot-data


# ── WORKPILOT · outgoing Slack notification ───────────
# Bot token for server-side chat.postMessage. Needs chat:write scope.
# SLACK_BOT_TOKEN=xoxb-replace-me

# Stable Slack user ID that receives the private App Home notification.
# SLACK_RECIPIENT_USER_ID=U0123456789


# ── OPTIONAL TOOLS ────────────────────────────────────
# EXA_API_KEY=
# EXA_SEARCH_TYPE=fast
# AMBIGUOUS_API_KEY=
